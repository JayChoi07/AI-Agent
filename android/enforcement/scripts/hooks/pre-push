#!/usr/bin/env bash
# 푸시 직전에 게이트 네 단계를 돌리고 실패하면 푸시를 막는다 (R-31-19).
# 프로젝트의 scripts/hooks/pre-push 로 복사하고, 저장소를 받은 뒤 한 번 실행한다:
#   git config core.hooksPath scripts/hooks
set -euo pipefail

root=$(git rev-parse --show-toplevel)
head_sha=$(git rev-parse HEAD)

# 표준 입력: "<local ref> <local sha> <remote ref> <remote sha>". 브랜치·태그 삭제만 있는 푸시는 검사하지 않는다.
has_update=false
while read -r local_ref local_sha _remote_ref _remote_sha; do
  case "$local_sha" in
    *[!0]*) ;;
    *) continue ;;
  esac
  has_update=true
  # 검사는 지금 체크아웃한 작업 트리를 돈다. 다른 커밋을 푸시하면 검사한 것과 올라가는 것이 달라지므로 막는다.
  case "$local_ref" in
    refs/heads/*)
      if [ "$local_sha" != "$head_sha" ]; then
        echo "pre-push: $local_ref 는 체크아웃한 HEAD 가 아니다. 그 브랜치를 체크아웃한 뒤 푸시한다." >&2
        exit 1
      fi
      ;;
  esac
done

if [ "$has_update" = false ]; then
  exit 0
fi

if ! git diff --quiet HEAD --; then
  echo "pre-push: 추적 파일에 커밋되지 않은 변경이 있다. 커밋하거나 stash 한 뒤 푸시한다." >&2
  exit 1
fi

exec "$root/scripts/check.sh" < /dev/null
